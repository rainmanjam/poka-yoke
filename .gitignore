__pycache__/
*.py[cod]
.venv/
venv/
.mypy_cache/
.pytest_cache/
.ruff_cache/
node_modules/
.DS_Store
.remember/
*.skill
poka-yoke-workspace/
.claude/settings.local.json
.claude/commands/
benchmarks/results/_pre-fix/

# YouTube script project, local working files, not part of the plugin
video/

# Working directories for the review and outreach orchestrators, raw per-agent output,
# reproducible and large.
.review-work/
.outreach-work/

# Local working material: drafts, launch notes, the outreach plan, review output.
# The contents are ignored rather than the directory, so a file dropped in here is private
# by default. Only the README is committed, so the convention stays discoverable.
private/*
!private/README.md

# Crop-proof overlays from scripts/make_banners.js. They verify that each banner survives
# the crop its platform applies, which is worth checking and not worth committing. Regenerate
# with `node scripts/make_banners.js`.
docs/assets/banner/_proof-*.png

# Grader-validation working material. focus.md embeds every sampled response in full, so it
# is large, it is regenerable from sample.jsonl, and a half-labelled copy in git history is
# worse than no copy: someone would eventually read stale verdicts as the finished review.
# The verdicts that matter end up in a written-up result, not in the worksheet.
# Regenerate with: python3 benchmarks/validate_grader.py --sample N && --focus N
benchmarks/results/validation/*.md
benchmarks/results/validation/*.jsonl
benchmarks/results/validation/second-grader-*.json
benchmarks/results/validation/contested.json
# ...but keep archived results. baseline-only-2026-08-24/ records a sample that was drawn
# through a broken filter, with a README separating what survives from what does not. That is
# a finding, not scratch, and deleting it would leave the correction with nothing to point at.
!benchmarks/results/validation/*/
